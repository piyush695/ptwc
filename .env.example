# ─── DATABASE ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/holaprime_worldcup"
REDIS_URL="redis://localhost:6379"

# ─── AUTH ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-key-min-32-chars"

# ─── BROKER API ───────────────────────────────────────────────────────────
MT5_API_URL="https://api.your-broker.com"
MT5_API_KEY="your-mt5-api-key"
MT5_MANAGER_LOGIN="12345"
MT5_MANAGER_PASSWORD="your-manager-password"
MT5_SERVER="your-server.com:443"

# ─── EMAIL ────────────────────────────────────────────────────────────────
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your-sendgrid-api-key"
EMAIL_FROM="noreply@worldcup.holaprime.com"

# ─── STORAGE ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── APP ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEBSOCKET_URL="ws://localhost:3001"
ADMIN_SEED_EMAIL="admin@holaprime.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# ─── ANTI-CHEAT ───────────────────────────────────────────────────────────
MIN_TRADE_DURATION_SECONDS="1"
HFT_THRESHOLD_TRADES_PER_HOUR="100"
